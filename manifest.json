{
  "manifest_version": 3,
  "name": "Youtube Aid",
  "version": "1.19.0",
  "description": "Trợ lý YouTube gọn nhẹ: bỏ quảng cáo, lặp video, tải MP3/MP4, copy tiêu đề và link sạch, cắt ảnh bìa, bookmark, phím tắt.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "clipboardRead",
    "downloads",
    "declarativeNetRequest",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://music.youtube.com/*",
    "https://*.loader.to/*",
    "https://*.affadaffa.com/*",
    "https://*.savenow.to/*",
    "https://*.googlevideo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "i18n.js",
        "shortcut-keys.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Youtube Aid - Cài đặt & Phím tắt",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}