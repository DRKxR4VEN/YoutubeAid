{
  "manifest_version": 3,
  "name": "Youtube Aid",
  "version": "1.16.2",
  "description": "Tiện ích mở rộng YouTube: Copy title thông minh, Clean link không tracking, phím tắt tùy chỉnh trên YouTube & YouTube Music, tự động copy/dán khi bôi đen, tải ảnh bìa/avatar/banner có cắt ảnh và tự động lặp video (bỏ qua quảng cáo), bookmark video xem sau.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "i18n.js",
        "shortcut-keys.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Youtube Aid - Cài đặt & Phím tắt",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}